<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.antigravity.argon-bridge</string>
    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON_BIN}}</string>
        <string>{{HOME}}/.local/share/agy-argon/gemini_argon_bridge.py</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{{HOME}}/.local/share/agy-argon/bridge.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{{HOME}}/.local/share/agy-argon/bridge.stderr.log</string>
    <key>WorkingDirectory</key>
    <string>{{HOME}}/.local/share/agy-argon</string>
</dict>
</plist>
